{"nodes": [{"id": "audit_analisa_02_audit_memori_streaming_gapless_dan_konkurensi_doc", "label": "02 Audit Memori, Streaming, Gapless Playback, & Konkurensi", "file_type": "document", "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L1-L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audits full-file RAM allocation vs 64MB sliding-window ring buffer, mlock/munlock lifecycle, gapless playback handover, and thread safety / atomic CAS synchronization."}, {"id": "audit_analisa_02_audit_memori_streaming_gapless_dan_konkurensi_sliding_window_ring_buffer", "label": "64 MB Sliding-Window Ring Buffer & Background Decode Thread", "file_type": "rationale", "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L30-L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-decoding 5 seconds synchronously for <50ms startup while streaming the rest on a background thread bounds memory at 64MB, avoiding multi-GB RAM spikes on long 192kHz files."}, {"id": "audit_analisa_02_audit_memori_streaming_gapless_dan_konkurensi_gapless_handover", "label": "Real-Time Sample-Accurate Gapless Playback Handover", "file_type": "rationale", "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L69-L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-buffering 32MB of the next track allows CoreAudio handleRender to splice remaining frames seamlessly inside the real-time callback without tearing down the AudioUnit or relying on a 250ms Main Thread timer."}, {"id": "audit_analisa_02_audit_memori_streaming_gapless_dan_konkurensi_atomic_cas_seek", "label": "Atomic Compare-And-Swap (CAS) Frame Advancement & Thread Safety", "file_type": "rationale", "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L113-L139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using compare_exchange_strong in handleRender prevents the real-time audio callback from overwriting concurrent user seekTo mutations on m_currentFrame."}, {"id": "src_nativemain_cpp_tsrossaaudiobridge_tsrossaaudiobridge", "label": "TsrossaAudioBridge (C/C++ FFI Bridge)", "file_type": "code", "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L6-L130", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "macos_sources_audioengine_audioengine", "label": "AudioEngine (Swift Audio Controller)", "file_type": "code", "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L7-L133", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "audit_analisa_02_audit_memori_streaming_gapless_dan_konkurensi_doc", "target": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L4", "weight": 1.0}, {"source": "audit_analisa_02_audit_memori_streaming_gapless_dan_konkurensi_doc", "target": "src_nativemain_cpp_tsrossaaudiobridge_tsrossaaudiobridge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L6", "weight": 1.0}, {"source": "audit_analisa_02_audit_memori_streaming_gapless_dan_konkurensi_doc", "target": "macos_sources_audioengine_audioengine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/02-AUDIT-MEMORI-STREAMING-GAPLESS-DAN-KONKURENSI.md", "source_location": "L7", "weight": 1.0}, {"source": "a