{"nodes": [{"id": "audit_analisa_07_audit_bug_window_resize_fit_screen_dan_menu_lag_doc", "label": "07 Audit Bug Window Resize, Double-Tap Fit-to-Screen, & Menu Lag", "file_type": "document", "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L1-L375", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root-cause analysis of the 3 bugs in bug-note.md: ZStack + scaledToFill layout inflation during window resize, HiddenTitleBarWindowStyle swallowing double-tap Fit-to-Screen events, and Combine ObservableObject 4Hz global re-renders + main-thread disk I/O."}, {"id": "audit_analisa_07_audit_bug_window_resize_fit_screen_dan_menu_lag_zstack_scaledtofill_trap", "label": "ZStack + Image.scaledToFill() Layout Inflation Trap", "file_type": "rationale", "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L48-L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placing a 1:1 square artwork with .scaledToFill() as a direct child in the root ZStack inflates the ZStack height to match the window width (e.g. 1500x1500 in a 1500x850 window), pushing top and bottom bars off-screen; background must be isolated inside a layout-neutral .background modifier."}, {"id": "audit_analisa_07_audit_bug_window_resize_fit_screen_dan_menu_lag_window_zoom_manager", "label": "WindowZoomManager & Dual-Trigger Double-Tap Fit-to-Screen", "file_type": "rationale", "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L194-L224", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because HiddenTitleBarWindowStyle covers the titlebar with NSHostingView, double-click/double-tap events must be handled via WindowZoomManager toggling window.frame to NSScreen.visibleFrame and restoring savedRestoreFrame."}, {"id": "audit_analisa_07_audit_bug_window_resize_fit_screen_dan_menu_lag_observable_progress_isolation", "label": "AudioProgressModel Isolation & Negative Cache for AlbumArtCache", "file_type": "rationale", "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L237-L369", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separating 4Hz currentTime updates into AudioProgressModel stops AudioEngine.objectWillChange from re-rendering all 6 major views every 250ms, while negative caching in AlbumArtCache eliminates synchronous SHA256 + disk I/O misses on the Main Thread."}, {"id": "macos_sources_mainappview_mainappview", "label": "MainAppView (Root Workspace View)", "file_type": "code", "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L9-L153", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "macos_sources_liquidglasscomponents_liquidglasscomponents", "label": "LiquidGlassComponents (Glass Modifiers & Ambient Background)", "file_type": "code", "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L10-L81", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "macos_sources_albumartcache_albumartcache", "label": "AlbumArtCache (In-Memory & Disk Artwork Thumbnail Cache)", "file_type": "code", "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L14-L333", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "audit_analisa_07_audit_bug_window_resize_fit_screen_dan_menu_lag_doc", "target": "macos_sources_mainappview_mainappview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/07-AUDIT-BUG-WINDOW-RESIZE-FIT-SCREEN-DAN-MENU-LAG.md", "source_location": "L9", "weight":