{"nodes": [{"id": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_doc", "label": "01 Audit Audio Engine, DSP, & CoreAudio HAL", "file_type": "document", "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L1-L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audits C++ signal path, float32 truncation vs int32 bit-perfect pass, 64-bit double DSP attenuation, SplitMix64 TPDF dithering, per-sample volume ramping, sample rate negotiation, and Hog Mode."}, {"id": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_bit_perfect_signal_path", "label": "Bit-Perfect Integer Signal Path vs Float32 Truncation", "file_type": "rationale", "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L29-L72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IEEE 754 32-bit float only has 24-bit mantissa (25-bit signed precision), truncating 7-8 LSBs of 32-bit integer PCM tracks unless direct integer pass or 64-bit double DSP with TPDF dithering is used."}, {"id": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_splitmix64_tpdf_dither", "label": "Dual-Channel SplitMix64 TPDF Dithering & std::llrint Rounding", "file_type": "rationale", "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L75-L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents nonlinear quantization distortion and noise modulation during attenuated (< 0 dBFS) 64-bit double DSP volume scaling by injecting decorrelated triangular PDF noise at target LSB scale before unbiased rounding."}, {"id": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_volume_ramping", "label": "Per-Sample Linear Volume Ramping (Anti-Zipper Noise)", "file_type": "rationale", "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L84-L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frame-locked linear gain interpolation (currentGain += stepGain) prevents step discontinuities at callback boundaries that otherwise cause audible clicks on low-frequency signals."}, {"id": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_sample_rate_negotiation", "label": "Hardware Nominal Sample Rate Validation & Fallback", "file_type": "rationale", "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L102-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checking kAudioDevicePropertyAvailableNominalSampleRates and selecting the nearest integer-multiple rate prevents silent OS software sample rate conversion (SRC) when playing high-rate tracks on limited DACs."}, {"id": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_hog_mode_exclusive_access", "label": "CoreAudio kAudioDevicePropertyHogMode Exclusive Lock", "file_type": "rationale", "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L127-L140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in Apple Silicon ports bypass kAudioDevicePropertyHogMode and run in shared mode, so telemetry must distinguish actual hardware hog lock from user preference."}, {"id": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "label": "CoreAudioSink (C++ Audio HAL Sink)", "file_type": "code", "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L3-L140", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_doc", "target": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L31-L32", "weight": 1.0}, {"source": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_bit_perfect_signal_path", "target": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L48-L72", "weight": 1.0}, {"source": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_splitmix64_tpdf_dither", "target": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L75-L81", "weight": 1.0}, {"source": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_volume_ramping", "target": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L84-L99", "weight": 1.0}, {"source": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_sample_rate_negotiation", "target": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L102-L124", "weight": 1.0}, {"source": "audit_analisa_01_audit_audio_engine_dsp_dan_coreaudio_hog_mode_exclusive_access", "target": "src_nativemain_cpp_coreaudiosink_coreaudiosink", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AUDIT-ANALISA/01-AUDIT-AUDIO-ENGINE-DSP-DAN-COREAUDIO.md", "source_location": "L127-L140", "weight": 1.0}], "hyperedges": [{"id": "coreaudio_bit_perfect_dsp_pipeline", "label": "CoreAudio Bit-Perfect & 64-Bit DSP Pipeline Requirements", "nodes": ["src_nativemain_c